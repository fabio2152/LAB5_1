# Copiar este archivo como .env y completar los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# --- Base de datos (PostgreSQL) ---
DB_NAME=champions
DB_USER=postgres
# Obligatoria: contraseña del usuario de PostgreSQL
DB_PASSWORD=

# --- Aplicación ---
# Puerto del equipo anfitrión donde se publica la aplicación
APP_PORT=8080
# Zona horaria en que se muestran las fechas
APP_TIMEZONE=America/Lima
# Imagen de la aplicación (en el paso de publicación será la de Docker Hub)
APP_IMAGE=lab5-champions:local

# --- API pública TheSportsDB ---
SPORTSDB_API_KEY=123
SPORTSDB_LEAGUE_ID=4480
SPORTSDB_SEASON=2026-2027
SPORTSDB_ROUNDS=1,2,3,4,5,6,7,8
SPORTSDB_DELAY_MS=3000
SPORTSDB_SYNC_ON_STARTUP=true
